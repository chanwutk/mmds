# Query-type experiment inputs and results (chunk files hold machine-specific paths),
# except the WLD summaries, which hold only scores, times and token counts.
# Git cannot re-include a file inside an ignored folder, so folders are re-included first.
data/query_types/**
!data/query_types/**/
!data/query_types/wld/presence/summary.json
!data/query_types/wld/localization/summary.json
# WLD documentaries, annotations and subtitles (third-party data, fetched locally)
data/wld/

